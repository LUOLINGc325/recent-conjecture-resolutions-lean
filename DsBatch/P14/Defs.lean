import Mathlib

/-!
# P14 — Definitions

Definitions from L. Sabatini, "Arithmetic properties of solubilizers"
(arXiv 2610.03151).

For a group `G` and an element `x : G`:

* `cyclicSubgroup x` is the cyclic subgroup `⟨x⟩`;
* `normalizerOf x` is the subgroup `N_G(x)` of the paper: the elements `g : G`
  with `⟨x⟩ ⊴ ⟨x, g⟩`, i.e. the normalizer in `G` of `⟨x⟩`;
* `solubilizer x` is the set `Sol_G(x) = {g : G : ⟨x, g⟩ is soluble}`;
* `solubilizerIn x K` is `Sol_G(x) ∩ K`, regarded as a subset of `K`.
-/

namespace DsBatch.P14

variable {G : Type*} [Group G]

/-- The cyclic subgroup `⟨x⟩` generated by `x`. -/
def cyclicSubgroup (x : G) : Subgroup G := Subgroup.closure ({x} : Set G)

/-- The normalizer `N_G(x)` of `⟨x⟩` in `G`, i.e. the set of `g : G` such that
`⟨x⟩ ⊴ ⟨x, g⟩`. -/
def normalizerOf (x : G) : Subgroup G :=
  Subgroup.normalizer ((cyclicSubgroup x : Subgroup G) : Set G)

/-- The solubilizer `Sol_G(x)`: the set of `g : G` for which `⟨x, g⟩` is
soluble. -/
def solubilizer (x : G) : Set G :=
  {g : G | Group.IsSolvable (Subgroup.closure ({x, g} : Set G))}

/-- The set `Sol_G(x) ∩ K`, regarded as a subset of `K`. -/
def solubilizerIn (x : G) (K : Subgroup G) : Set K :=
  {g : K | Group.IsSolvable (Subgroup.closure ({x, (g : G)} : Set G))}

end DsBatch.P14
