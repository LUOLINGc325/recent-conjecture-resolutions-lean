import DsBatch.P14.Basic

/-!
# P14 — The maximality claim

This file contains the group-theoretic core of the proof of Theorem `thMain`:
the solubility/normality manipulation behind the claim
`(H/T) ∩ Z(K/T) = 1` for a maximal admissible subgroup `T ≤ K`.
-/

namespace DsBatch.P14

open scoped Pointwise

universe u

variable {G : Type u} [Group G]

variable {K : Subgroup G}

/-- If conjugation by `d` maps the generators of a subgroup into the subgroup,
then it maps the whole subgroup into itself (closure induction). -/
lemma conj_maps_closure {S : Set G} {d : G}
    (hgen : ∀ y ∈ S, d * y * d⁻¹ ∈ Subgroup.closure S) :
    ∀ y ∈ Subgroup.closure S, d * y * d⁻¹ ∈ Subgroup.closure S := by
  intro y hy
  induction hy using Subgroup.closure_induction with
  | mem z hz => exact hgen z hz
  | one => simp
  | mul y z _ _ ihy ihz =>
      rw [show d * (y * z) * d⁻¹ = (d * y * d⁻¹) * (d * z * d⁻¹) by group]
      exact Subgroup.mul_mem _ ihy ihz
  | inv y _ ihy =>
      rw [show d * y⁻¹ * d⁻¹ = (d * y * d⁻¹)⁻¹ by group]
      exact Subgroup.inv_mem _ ihy

/-- If both conjugation by `d` and by `d⁻¹` map a generating set into the
subgroup it generates, then `d` lies in the normalizer of that subgroup. -/
lemma mem_normalizer_closure_of_generators {S : Set G} {d : G}
    (hgen : ∀ y ∈ S, d * y * d⁻¹ ∈ Subgroup.closure S)
    (hgen' : ∀ y ∈ S, d⁻¹ * y * d ∈ Subgroup.closure S) :
    d ∈ Subgroup.normalizer (Subgroup.closure S : Set G) := by
  rw [Subgroup.mem_set_normalizer_iff]
  intro y
  constructor
  · exact conj_maps_closure hgen y
  · intro hy
    have hgen'' : ∀ y ∈ S, d⁻¹ * y * (d⁻¹)⁻¹ ∈ Subgroup.closure S := by
      intro y hy
      simpa using hgen' y hy
    have h := conj_maps_closure hgen'' (d * y * d⁻¹) hy
    simpa [mul_assoc] using h

/-- The subgroup generated by `x`, `a` and the image of `T ≤ K` in `G`. -/
def threeGen {K : Subgroup G} (x : G) (a : G) (T : Subgroup K) : Subgroup G :=
  Subgroup.closure ({(x : G), a} ∪ (T.map (Subgroup.subtype K) : Set G))

/-- The generators of `threeGen` lie in it. -/
lemma pair_subset_threeGen {x a : G} {T : Subgroup K} :
    ({(x : G), a} : Set G) ⊆ (threeGen x a T : Set G) := by
  intro y hy
  exact Subgroup.subset_closure (Set.mem_union_left _ hy)

/-- The image of `T` lies in `threeGen x a T`. -/
lemma map_subset_threeGen {x a : G} {T : Subgroup K} :
    (T.map (Subgroup.subtype K) : Set G) ⊆ (threeGen x a T : Set G) := by
  intro y hy
  exact Subgroup.subset_closure (Set.mem_union_right _ hy)

/-- `threeGen` is monotone in `T` (as a subgroup of `K`). -/
lemma threeGen_mono {x a : G} {T T' : Subgroup K} (h : T ≤ T') :
    threeGen x a T ≤ threeGen x a T' := by
  apply Subgroup.closure_mono
  intro y hy
  rcases hy with hy | hy
  · exact Set.mem_union_left _ hy
  · exact Set.mem_union_right _ (Subgroup.map_mono h hy)



/-! ## Membership lemmas for `threeGen` -/

lemma cyclicSubgroup_le_threeGen {x a : G} {T : Subgroup K} :
    cyclicSubgroup x ≤ threeGen x a T := by
  rw [cyclicSubgroup, Subgroup.closure_le]
  intro y hy
  rw [Set.mem_singleton_iff] at hy
  subst hy
  exact pair_subset_threeGen (by simp)

lemma x_mem_threeGen {x a : G} {T : Subgroup K} : x ∈ threeGen x a T :=
  pair_subset_threeGen (by simp)

lemma a_mem_threeGen {x a : G} {T : Subgroup K} : a ∈ threeGen x a T :=
  pair_subset_threeGen (by simp)

lemma coe_mem_threeGen_of_mem {x a : G} {T : Subgroup K} {t : K} (ht : t ∈ T) :
    (t : G) ∈ threeGen x a T :=
  map_subset_threeGen (Subgroup.mem_map_of_mem K.subtype ht)

/-! ## The maximality claim `(H/T) ∩ Z(K/T) = 1` -/

/-- **The maximality claim.**  Let `T ≤ H` be a subgroup of `K`, normal in both
`H` and `K`, maximal among the subgroups `T' ≤ H` normal in `H` and in `K`
such that `⟨x, a, T'⟩` is soluble for all `a ∈ A`.  Then the image of `H` in
`K/T` meets the centre of `K/T` trivially. -/
theorem claim_center_inf {x : G} {A : Set K} {H T : Subgroup K}
    [hT : T.Normal]
    (hHN : ∀ h : H, (h : G) ∈ normalizerOf x)
    (hTH : T ≤ H)
    (hTHn : ∀ h : H, ∀ t ∈ T, (h : K) * t * (h : K)⁻¹ ∈ T)
    (hsol : ∀ a : K, a ∈ A → Group.IsSolvable (threeGen x (a : G) T))
    (hmax : ∀ T' : Subgroup K, T ≤ T' → T' ≤ H →
        (∀ k : K, ∀ t ∈ T', k * t * k⁻¹ ∈ T') →
        (∀ h : H, ∀ t ∈ T', (h : K) * t * (h : K)⁻¹ ∈ T') →
        (∀ a : K, a ∈ A → Group.IsSolvable (threeGen x (a : G) T')) →
        T' ≤ T) :
    H.map (QuotientGroup.mk' T) ⊓ Subgroup.center (K ⧸ T) = ⊥ := by
  classical
  set Hbar : Subgroup (K ⧸ T) := H.map (QuotientGroup.mk' T) with hHbar
  set Dbar : Subgroup (K ⧸ T) := Hbar ⊓ Subgroup.center (K ⧸ T) with hDbar
  set D : Subgroup K := Dbar.comap (QuotientGroup.mk' T) with hD
  -- `T` is contained in `D`
  have hTD : T ≤ D := by
    intro t ht
    rw [hD, Subgroup.mem_comap]
    have ht1 : (QuotientGroup.mk' T) t = 1 := by
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact ht
    rw [hDbar, ht1]
    exact ⟨Subgroup.one_mem _, Subgroup.one_mem _⟩
  -- `D` is contained in `H`
  have hDH : D ≤ H := by
    intro d hd
    rw [hD, Subgroup.mem_comap] at hd
    have hdHbar : (QuotientGroup.mk' T) d ∈ Hbar := hd.1
    rw [hHbar] at hdHbar
    obtain ⟨h, hhH, hh⟩ := Subgroup.mem_map.mp hdHbar
    have hmem : h⁻¹ * d ∈ T := by
      refine QuotientGroup.eq.mp ?_
      simpa only [QuotientGroup.mk'_apply] using hh
    have hd_eq : h * (h⁻¹ * d) = d := by group
    rw [← hd_eq]
    exact H.mul_mem hhH (hTH hmem)
  -- `D` is normal in `K`
  have hDnormalK : ∀ k : K, ∀ d ∈ D, k * d * k⁻¹ ∈ D := by
    intro k d hd
    rw [hD, Subgroup.mem_comap] at hd ⊢
    have hcent : ∀ g : K ⧸ T, g * (QuotientGroup.mk' T) d = (QuotientGroup.mk' T) d * g :=
      Subgroup.mem_center_iff.mp hd.2
    have hk : (QuotientGroup.mk' T) (k * d * k⁻¹) = (QuotientGroup.mk' T) d := by
      rw [map_mul, map_mul, map_inv, hcent (QuotientGroup.mk' T k)]
      group
    rw [hk]
    exact hd
  -- `D` is normal in `H`
  have hDnormalH : ∀ h : H, ∀ d ∈ D, (h : K) * d * (h : K)⁻¹ ∈ D := by
    intro h d hd
    rw [hD, Subgroup.mem_comap] at hd ⊢
    have hcent : ∀ g : K ⧸ T, g * (QuotientGroup.mk' T) d = (QuotientGroup.mk' T) d * g :=
      Subgroup.mem_center_iff.mp hd.2
    have hk : (QuotientGroup.mk' T) ((h : K) * d * (h : K)⁻¹) = (QuotientGroup.mk' T) d := by
      rw [map_mul, map_mul, map_inv, hcent (QuotientGroup.mk' T (h : K))]
      group
    rw [hk]
    exact hd
  -- `D` normalizes `⟨x, a, T⟩` for each `a ∈ A`
  have hDnorm : ∀ a : K, ∀ d ∈ D,
      (d : G) ∈ Subgroup.normalizer ((threeGen x (a : G) T : Subgroup G) : Set G) := by
    intro a d hd
    have hdH := hDH hd
    have hdN : (d : G) ∈ normalizerOf x := hHN ⟨d, hdH⟩
    have hdcent : (QuotientGroup.mk' T) d ∈ Subgroup.center (K ⧸ T) := by
      rw [hD, Subgroup.mem_comap] at hd
      exact hd.2
    have hdcenter : ∀ g : K ⧸ T, g * (QuotientGroup.mk' T) d = (QuotientGroup.mk' T) d * g :=
      Subgroup.mem_center_iff.mp hdcent
    refine mem_normalizer_closure_of_generators
      (S := ({x, (a : G)} ∪ (T.map K.subtype : Set G))) ?_ ?_
    · intro y hy
      rcases hy with hy | hy
      · rw [Set.mem_insert_iff] at hy
        rcases hy with hyx | hya
        · rw [hyx]
          exact cyclicSubgroup_le_threeGen (conj_mem_cyclicSubgroup hdN)
        · rw [Set.mem_singleton_iff] at hya
          rw [hya]
          have hmk : (QuotientGroup.mk' T) (d * a * d⁻¹) = (QuotientGroup.mk' T) a := by
            rw [map_mul, map_mul, map_inv, (hdcenter (QuotientGroup.mk' T a)).symm]
            group
          have hmemT : a⁻¹ * (d * a * d⁻¹) ∈ T := by
            refine QuotientGroup.eq.mp ?_
            simpa only [QuotientGroup.mk'_apply] using hmk.symm
          have heq : (d * a * d⁻¹ : K) = a * (a⁻¹ * (d * a * d⁻¹)) := by group
          have h1 : (a : G) ∈ threeGen x (a : G) T := a_mem_threeGen
          have h2 : ((a⁻¹ * (d * a * d⁻¹) : K) : G) ∈ threeGen x (a : G) T :=
            coe_mem_threeGen_of_mem hmemT
          have hprod : ((a * (a⁻¹ * (d * a * d⁻¹)) : K) : G) ∈ threeGen x (a : G) T := by
            simpa [Subgroup.coe_mul] using Subgroup.mul_mem _ h1 h2
          have : ((d * a * d⁻¹ : K) : G) ∈ threeGen x (a : G) T := by
            rw [heq]
            exact hprod
          simpa [threeGen, Subgroup.coe_mul, Subgroup.coe_inv] using this
      · obtain ⟨t, ht, rfl⟩ := Subgroup.mem_map.mp hy
        exact coe_mem_threeGen_of_mem (hT.conj_mem t ht d)
    · intro y hy
      rcases hy with hy | hy
      · rw [Set.mem_insert_iff] at hy
        rcases hy with hyx | hya
        · rw [hyx]
          have hdN' : ((d⁻¹ : K) : G) ∈ normalizerOf x :=
            hHN ⟨d⁻¹, hDH (D.inv_mem hd)⟩
          exact cyclicSubgroup_le_threeGen
            (by simpa [Subgroup.coe_inv, inv_inv] using conj_mem_cyclicSubgroup hdN')
        · rw [Set.mem_singleton_iff] at hya
          rw [hya]
          have hdcenter' : ∀ g : K ⧸ T,
              ((QuotientGroup.mk' T) d)⁻¹ * g = g * ((QuotientGroup.mk' T) d)⁻¹ := by
            intro g
            have h := hdcenter g
            calc ((QuotientGroup.mk' T) d)⁻¹ * g
                = ((QuotientGroup.mk' T) d)⁻¹ * (g * (QuotientGroup.mk' T) d) *
                    ((QuotientGroup.mk' T) d)⁻¹ := by group
              _ = ((QuotientGroup.mk' T) d)⁻¹ * ((QuotientGroup.mk' T) d * g) *
                    ((QuotientGroup.mk' T) d)⁻¹ := by rw [h]
              _ = g * ((QuotientGroup.mk' T) d)⁻¹ := by group
          have hmk : (QuotientGroup.mk' T) (d⁻¹ * a * d) = (QuotientGroup.mk' T) a := by
            rw [map_mul, map_mul, map_inv, hdcenter' (QuotientGroup.mk' T a)]
            group
          have hmemT : a⁻¹ * (d⁻¹ * a * d) ∈ T := by
            refine QuotientGroup.eq.mp ?_
            simpa only [QuotientGroup.mk'_apply] using hmk.symm
          have heq : (d⁻¹ * a * d : K) = a * (a⁻¹ * (d⁻¹ * a * d)) := by group
          have h1 : (a : G) ∈ threeGen x (a : G) T := a_mem_threeGen
          have h2 : ((a⁻¹ * (d⁻¹ * a * d) : K) : G) ∈ threeGen x (a : G) T :=
            coe_mem_threeGen_of_mem hmemT
          have hprod : ((a * (a⁻¹ * (d⁻¹ * a * d)) : K) : G) ∈
              threeGen x (a : G) T := by
            simpa [Subgroup.coe_mul] using Subgroup.mul_mem _ h1 h2
          have : ((d⁻¹ * a * d : K) : G) ∈ threeGen x (a : G) T := by
            rw [heq]
            exact hprod
          simpa [threeGen, Subgroup.coe_mul, Subgroup.coe_inv] using this
      · obtain ⟨t, ht, rfl⟩ := Subgroup.mem_map.mp hy
        have ht' : d⁻¹ * t * (d⁻¹)⁻¹ ∈ T := hT.conj_mem t ht d⁻¹
        have hcoe : ((d⁻¹ * t * (d⁻¹)⁻¹ : K) : G) ∈ threeGen x (a : G) T :=
          coe_mem_threeGen_of_mem ht'
        simpa [threeGen, Subgroup.coe_mul, Subgroup.coe_inv, inv_inv] using hcoe
  -- solubility of `⟨x, a, D⟩`
  have hDsol : ∀ a : K, a ∈ A → Group.IsSolvable (threeGen x (a : G) D) := by
    intro a ha
    set U : Subgroup G := threeGen x (a : G) T with hUdef
    set W : Subgroup G := threeGen x (a : G) D with hWdef
    have hUW : U ≤ W := threeGen_mono hTD
    have hUleW_norm : U ≤ Subgroup.normalizer (U : Set G) := Subgroup.le_normalizer
    have hDleNormU : ∀ d : K, d ∈ D → (d : G) ∈ Subgroup.normalizer (U : Set G) :=
      fun d hd => hDnorm a d hd
    have hWleNormU : W ≤ Subgroup.normalizer (U : Set G) := by
      rw [hWdef, threeGen, Subgroup.closure_le]
      intro y hy
      rcases hy with hy | hy
      · rw [Set.mem_insert_iff] at hy
        rcases hy with hyx | hya
        · rw [hyx]
          exact hUleW_norm (by rw [hUdef]; exact x_mem_threeGen)
        · rw [Set.mem_singleton_iff] at hya
          rw [hya]
          exact hUleW_norm (by rw [hUdef]; exact a_mem_threeGen)
      · obtain ⟨d, hd, rfl⟩ := Subgroup.mem_map.mp hy
        exact hDleNormU d hd
    haveI : (U.subgroupOf W).Normal :=
      (Subgroup.normal_subgroupOf_iff_le_normalizer hUW).mpr hWleNormU
    have hsolU : Group.IsSolvable ↥U := hsol a ha
    have hsolU' : Group.IsSolvable ↥(U.subgroupOf W) := by
      have e := Subgroup.subgroupOfEquivOfLe hUW
      exact Group.isSolvable_of_surjective (f := e.symm.toMonoidHom) e.symm.surjective
    have hcomm : IsMulCommutative (W ⧸ U.subgroupOf W) := by
      refine IsMulCommutative.of_comm (fun p q => ?_)
      induction p using QuotientGroup.induction_on with
      | _ w1 =>
      induction q using QuotientGroup.induction_on with
      | _ w2 =>
      -- every element of `W` is a product `d * u` with `d ∈ D.map`, `u ∈ U`
      have hDleNormUG : D.map K.subtype ≤ Subgroup.normalizer (U : Set G) := by
        intro y hy
        obtain ⟨d, hd, rfl⟩ := Subgroup.mem_map.mp hy
        exact hDleNormU d hd
      have hW_eq : W = D.map K.subtype ⊔ U := by
        apply le_antisymm
        · rw [hWdef, threeGen, Subgroup.closure_le]
          intro y hy
          rcases hy with hy | hy
          · rw [Set.mem_insert_iff] at hy
            rcases hy with hyx | hya
            · rw [hyx]
              exact Subgroup.mem_sup_right (by rw [hUdef]; exact x_mem_threeGen)
            · rw [Set.mem_singleton_iff] at hya
              rw [hya]
              exact Subgroup.mem_sup_right (by rw [hUdef]; exact a_mem_threeGen)
          · exact Subgroup.mem_sup_left hy
        · rw [Subgroup.sup_eq_closure, Subgroup.closure_le]
          intro y hy
          rcases hy with hy | hy
          · rw [hWdef, threeGen]
            exact Subgroup.subset_closure (Set.mem_union_right _ hy)
          · exact hUW hy
      have hset : ((D.map K.subtype ⊔ U : Subgroup G) : Set G) =
          (D.map K.subtype : Set G) * (U : Set G) :=
        Subgroup.coe_mul_of_left_le_normalizer_right (D.map K.subtype) U hDleNormUG
      have hW_le : W ≤ D.map K.subtype ⊔ U := hW_eq.le
      have hdecomp : ∀ w : W, ∃ d ∈ D.map K.subtype, ∃ u ∈ U,
          (w : G) = d * u := by
        intro w
        have hw : (w : G) ∈ ((D.map K.subtype ⊔ U : Subgroup G) : Set G) :=
          hW_le w.2
        rw [hset, Set.mem_mul] at hw
        obtain ⟨d, hd, u, hu, hdu⟩ := hw
        exact ⟨d, hd, u, hu, hdu.symm⟩
      -- the two classes, decomposed along `D` and `T`
      obtain ⟨d1, hd1, u1, hu1, hw1⟩ := hdecomp w1
      obtain ⟨d2, hd2, u2, hu2, hw2⟩ := hdecomp w2
      obtain ⟨c1, hc1D, hc1⟩ := Subgroup.mem_map.mp hd1
      obtain ⟨c2, hc2D, hc2⟩ := Subgroup.mem_map.mp hd2
      have hd1W : d1 ∈ W := hW_eq.symm ▸ Subgroup.mem_sup_left hd1
      have hu1W : u1 ∈ W := hW_eq.symm ▸ Subgroup.mem_sup_right hu1
      have hd2W : d2 ∈ W := hW_eq.symm ▸ Subgroup.mem_sup_left hd2
      have hu2W : u2 ∈ W := hW_eq.symm ▸ Subgroup.mem_sup_right hu2
      let d1W : W := ⟨d1, hd1W⟩
      let u1W : W := ⟨u1, hu1W⟩
      let d2W : W := ⟨d2, hd2W⟩
      let u2W : W := ⟨u2, hu2W⟩
      have hw1eq : w1 = d1W * u1W := Subtype.ext (by
        show (w1 : G) = ((d1W * u1W : W) : G)
        rw [hw1]
        simp [d1W, u1W, Subgroup.coe_mul])
      have hw2eq : w2 = d2W * u2W := Subtype.ext (by
        show (w2 : G) = ((d2W * u2W : W) : G)
        rw [hw2]
        simp [d2W, u2W, Subgroup.coe_mul])
      -- in the quotient the `U`-parts vanish
      have hq1 : (↑w1 : W ⧸ U.subgroupOf W) = ↑d1W := by
        refine QuotientGroup.eq.mpr ?_
        rw [Subgroup.mem_subgroupOf]
        have hprod : w1⁻¹ * d1W = u1W⁻¹ := by
          rw [hw1eq]
          group
        rw [hprod]
        simpa [u1W, Subgroup.coe_inv] using U.inv_mem hu1
      have hq2 : (↑w2 : W ⧸ U.subgroupOf W) = ↑d2W := by
        refine QuotientGroup.eq.mpr ?_
        rw [Subgroup.mem_subgroupOf]
        have hprod : w2⁻¹ * d2W = u2W⁻¹ := by
          rw [hw2eq]
          group
        rw [hprod]
        simpa [u2W, Subgroup.coe_inv] using U.inv_mem hu2
      rw [hq1, hq2]
      -- the images of `d1`, `d2` are central modulo `T`, hence commute
      have hc1c : (QuotientGroup.mk' T) c1 ∈ Subgroup.center (K ⧸ T) := by
        rw [hD, Subgroup.mem_comap] at hc1D
        exact hc1D.2
      have hc2c : (QuotientGroup.mk' T) c2 ∈ Subgroup.center (K ⧸ T) := by
        rw [hD, Subgroup.mem_comap] at hc2D
        exact hc2D.2
      have hcommc : (QuotientGroup.mk' T) c1 * (QuotientGroup.mk' T) c2 =
          (QuotientGroup.mk' T) c2 * (QuotientGroup.mk' T) c1 :=
        (Subgroup.mem_center_iff.mp hc1c (QuotientGroup.mk' T c2)).symm
      -- their commutator lies in `T`
      have hmemT : c2⁻¹ * c1⁻¹ * c2 * c1 ∈ T := by
        have hz : (QuotientGroup.mk' T) (c2⁻¹ * c1⁻¹ * c2 * c1) = 1 := by
          simp only [map_mul, map_inv]
          have h2 : ((QuotientGroup.mk' T) c2)⁻¹ * ((QuotientGroup.mk' T) c1)⁻¹ =
              (((QuotientGroup.mk' T) c1) * (QuotientGroup.mk' T) c2)⁻¹ := by
            group
          calc ((QuotientGroup.mk' T) c2)⁻¹ * ((QuotientGroup.mk' T) c1)⁻¹ *
                (QuotientGroup.mk' T) c2 * (QuotientGroup.mk' T) c1
              = (((QuotientGroup.mk' T) c1) * (QuotientGroup.mk' T) c2)⁻¹ *
                  (QuotientGroup.mk' T) c2 * (QuotientGroup.mk' T) c1 := by rw [h2]
            _ = (((QuotientGroup.mk' T) c2) * (QuotientGroup.mk' T) c1)⁻¹ *
                  (QuotientGroup.mk' T) c2 * (QuotientGroup.mk' T) c1 := by rw [hcommc]
            _ = 1 := by group
        rwa [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at hz
      -- `T` lies in `U`
      have hTleU : ((T.map K.subtype : Subgroup G) : Set G) ⊆ U := by
        intro y hy
        obtain ⟨t, ht, rfl⟩ := Subgroup.mem_map.mp hy
        rw [hUdef]
        exact coe_mem_threeGen_of_mem ht
      -- back to the quotient: the two classes agree
      rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul]
      refine QuotientGroup.eq.mpr ?_
      rw [Subgroup.mem_subgroupOf]
      have hGL : (((d1W * d2W)⁻¹ * (d2W * d1W) : W) : G) =
          ((c2⁻¹ * c1⁻¹ * c2 * c1 : K) : G) := by
        simp only [Subgroup.coe_mul, Subgroup.coe_inv, d1W, d2W]
        rw [← hc1, ← hc2]
        simp only [Subgroup.subtype_apply]
        group
      rw [hGL]
      exact hTleU (Subgroup.mem_map_of_mem K.subtype hmemT)
    haveI := hsolU'
    exact Group.isSolvable_of_subgroup_quotient (U.subgroupOf W)
  -- maximality forces `D = T`
  have hDleT : D ≤ T :=
    hmax D hTD hDH hDnormalK hDnormalH hDsol
  have hDT : D = T := le_antisymm hDleT hTD
  -- conclude the claim
  rw [eq_bot_iff]
  intro q hq
  have hqHbar : q ∈ Hbar := hq.1
  have hqDbar : q ∈ Dbar := by
    rw [hDbar]
    exact hq
  rw [hHbar] at hqHbar
  obtain ⟨h, hhH, hhq⟩ := Subgroup.mem_map.mp hqHbar
  have hDmem : h ∈ D := by
    rw [hD, Subgroup.mem_comap]
    rw [hhq]
    exact hqDbar
  have hTmem : h ∈ T := hDT ▸ hDmem
  simp only [Subgroup.mem_bot]
  rw [← hhq, QuotientGroup.mk'_apply]
  exact (QuotientGroup.eq_one_iff h).mpr hTmem

end DsBatch.P14
